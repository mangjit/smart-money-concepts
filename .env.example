# ── Application ──────────────────────────────────────────────────────────────
# The dashboard is served by the API, so no CORS configuration is needed for local use.
# For a separately hosted frontend, comma-separate exact origins (never use * in production).
CORS_ORIGINS=
APP_ENV=development
REQUEST_TIMEOUT_SECONDS=12

# ── Conversation memory (optional) ───────────────────────────────────────────
# Leave unset to use volatile in-memory context. Use a least-privilege MongoDB user.
MONGODB_URI=
MONGODB_DATABASE=smc_assistant
MONGODB_COLLECTION=conversations
MEMORY_TURNS=8

# ── Telegram (optional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Set a long random string. Telegram will send it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated numeric chat IDs. Empty permits all chats that can reach the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Used only by scripts/set_telegram_webhook.py. Must be a public HTTPS URL.
PUBLIC_WEBHOOK_BASE_URL=

# ── LLM providers (all optional; select them in the UI after configuring) ────
OPENAI_API_KEY=
OPENAI_GPT5_MODEL=gpt-5
OPENAI_GPT4_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
ANTHROPIC_OPUS_MODEL=claude-opus-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Configure this server URL only in trusted server-side deployment environments.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=false
